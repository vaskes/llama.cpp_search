# Preset: Ornith-1.5-35B-A3B Q8_0 + mmproj (multimodal, 512K ctx, yarn scaling)
# ⚠️ REQUIRES ≥256 GB RAM or ≥24 GB GPU. WILL FAIL on 58 GB hosts.
LLAMA_MODEL=/opt/models/Ornith-1.5-35B-A3B-Q8_0.gguf
LLAMA_MMPROJ=/opt/models/mmproj-Ornith-1.5-35B-A3B-bf16.gguf
LLAMA_ALIAS=Ornith-1.5-35B-A3B
LLAMA_CTX_SIZE=524288
LLAMA_NGL=99
LLAMA_BATCH=256
LLAMA_PORT=8080
LLAMA_HOST=0.0.0.0
LLAMA_EXTRA_ARGS=--rope-scaling yarn --yarn-orig-ctx 262144 --rope-freq-scale 2.0 --override-kv qwen35moe.context_length=int:524288 --cache-type-k q8_0 --cache-type-v q8_0 --cache-ram 0 --parallel 1 --no-warmup --flash-attn on --agent --jinja -n -1 --keep -1 --image-min-tokens 1024 --cors-origins "*"
