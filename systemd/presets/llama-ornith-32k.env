# Preset: Ornith-1.5-35B-A3B Q8_0 + mmproj (multimodal, 32K ctx for RAM-constrained hosts)
# Note: original was 524288 ctx — that needs ~200+ GB RAM. This preset uses 32K which
# fits in 58 GB. For full 512K context, use llama-ornith.env on a host with ≥256 GB RAM
# (or a GPU with ≥24 GB VRAM for the model + KV cache).
LLAMA_MODEL=/opt/models/Ornith-1.5-35B-A3B-Q8_0.gguf
LLAMA_MMPROJ=/opt/models/mmproj-Ornith-1.5-35B-A3B-bf16.gguf
LLAMA_ALIAS=Ornith-1.5-35B-A3B
LLAMA_CTX_SIZE=32768
LLAMA_NGL=99
LLAMA_BATCH=256
LLAMA_PORT=8080
LLAMA_HOST=0.0.0.0
# Removed --override-kv qwen35moe.context_length=int:524288 (use model's natural ctx)
# Removed --rope-scaling yarn (32K is within model native range)
LLAMA_EXTRA_ARGS=--cache-type-k q8_0 --cache-type-v q8_0 --cache-ram 0 --parallel 1 --no-warmup --flash-attn on --agent --jinja -n -1 --keep -1 --image-min-tokens 1024 --cors-origins "*"
